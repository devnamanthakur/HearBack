# Hearback environment variables (example)
# Copy this file to `.env` and fill in your real values.

# MongoDB (Mongoose) connection URI
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hearback
MONGODB_URI=

# ---- Email delivery ----
# Two providers are supported, chosen via EMAIL_PROVIDER.

# Option 1 (recommended for demos, no domain needed): Gmail SMTP via Nodemailer.
# Setup: create a Gmail account -> enable 2-Step Verification -> generate an
# App Password (Security > App passwords). Paste the app password (no spaces).
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Hearback <you@gmail.com>

# Option 2: Resend (requires a verified custom domain; onboarding@resend.dev
# only delivers to the account owner's own inbox).
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# Demo OTP mode: when "true", verification emails are NOT sent and the OTP is
# shown directly on the /verify/[username] page. Handy as a local live-demo
# fallback if an email gets delayed or lands in Spam. Leave this "false" for
# real sending. It is ignored in production unless DEMO_OTP_ALLOW_PRODUCTION is
# also "true" — otherwise email verification could be bypassed entirely.
DEMO_OTP_MODE=false
# Double opt-in required to run demo OTP mode in production. Keep false.
DEMO_OTP_ALLOW_PRODUCTION=false

# Google Gemini (free tier) for the AI features:
#  - "Fix my English" / "Translate to English" in comments
#  - Auto-generating a post description from an uploaded lecture-notes PDF
#  - AI moderation of posts/comments in educational communities
# Get a free key at https://aistudio.google.com/apikey (no credit card).
# If left empty, the AI buttons are hidden and the app still works fully.
GEMINI_API_KEY=

# ---- AI moderation tuning (educational communities only) ----
# Moderation runs on a cheaper/faster model with its own free-tier bucket.
GEMINI_MODERATION_MODEL=gemini-3.5-flash-lite
# Max moderation requests per minute. Free tier is ~10-15 RPM; extra posts are
# allowed but flagged for teacher review instead of failing.
AI_MODERATION_RPM=8
# Timeout for one moderation request (ms). On timeout the post is allowed and
# flagged for review, so a slow AI never blocks the class.
AI_MODERATION_TIMEOUT_MS=4000
# Dev/demo only: when "true", every post/comment in an educational community is
# flagged for teacher review. Useful to demo the Review tab without a Gemini key.
AI_MODERATION_FORCE_REVIEW=false
# Blocked attempts before a member is auto-muted for 24 hours.
STRIKE_MUTE_THRESHOLD=3

# ---- Educational communities ----
# Email suffixes allowed for school-email verification, comma separated.
# Defaults to .edu.in,.ac.in,.edu,.ac.uk
EDU_EMAIL_DOMAINS=.edu.in,.ac.in,.edu,.ac.uk

# NextAuth / Auth.js secret used to sign session JWT cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional secret used to key the one-way hash stored when a school email is
# banned (src/lib/ban.ts). Falls back to AUTH_SECRET when unset. Changing it
# invalidates existing school-email blocks, so set it once and keep it stable.
BAN_HASH_SECRET=

# Password used by the demo seed users (scripts/seed-demo.ts) when
# SEED_DEMO_PASSWORD is not set.
# SEED_DEMO_PASSWORD=DemoPass123#

# Optional: full URL of the app (used to build absolute URLs on Vercel).
# Vercel usually sets this automatically.
# AUTH_URL=https://your-app.vercel.app